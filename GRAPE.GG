local KeySystem = {}
KeySystem.ValidKey = "GRAPE"
KeySystem.Attempts = 0
KeySystem.MaxAttempts = 5

local function createKeyGUI()
    local player = game.Players.LocalPlayer
    local playerGui = player:WaitForChild("PlayerGui")
    
    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "KeySystemGUI"
    screenGui.ResetOnSpawn = false
    screenGui.Parent = playerGui
    
    local mainFrame = Instance.new("Frame")
    mainFrame.Name = "MainFrame"
    mainFrame.Size = UDim2.new(0, 400, 0, 300)
    mainFrame.Position = UDim2.new(0.5, -200, 0.5, -150)
    mainFrame.BackgroundColor3 = Color3.fromRGB(31, 31, 103)
    mainFrame.BorderSizePixel = 0
    mainFrame.Parent = screenGui
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 15)
    corner.Parent = mainFrame
    
    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(60, 63, 221)
    stroke.Thickness = 2
    stroke.Parent = mainFrame
    
    local titleLabel = Instance.new("TextLabel")
    titleLabel.Name = "TitleLabel"
    titleLabel.Size = UDim2.new(1, 0, 0, 60)
    titleLabel.BackgroundTransparency = 1
    titleLabel.Text = "GRAPE.GG | Key System"
    titleLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    titleLabel.TextSize = 24
    titleLabel.Font = Enum.Font.GothamBold
    titleLabel.Parent = mainFrame
    
    local inputLabel = Instance.new("TextLabel")
    inputLabel.Name = "InputLabel"
    inputLabel.Size = UDim2.new(1, -20, 0, 30)
    inputLabel.Position = UDim2.new(0, 10, 0, 80)
    inputLabel.BackgroundTransparency = 1
    inputLabel.Text = "Enter Key:"
    inputLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
    inputLabel.TextSize = 14
    inputLabel.Font = Enum.Font.Gotham
    inputLabel.TextXAlignment = Enum.TextXAlignment.Left
    inputLabel.Parent = mainFrame
    
    local inputBox = Instance.new("TextBox")
    inputBox.Name = "InputBox"
    inputBox.Size = UDim2.new(1, -20, 0, 40)
    inputBox.Position = UDim2.new(0, 10, 0, 115)
    inputBox.BackgroundColor3 = Color3.fromRGB(50, 50, 100)
    inputBox.TextColor3 = Color3.fromRGB(255, 255, 255)
    inputBox.TextSize = 18
    inputBox.Font = Enum.Font.Gotham
    inputBox.PlaceholderText = "Type key here..."
    inputBox.PlaceholderColor3 = Color3.fromRGB(100, 100, 150)
    inputBox.BorderSizePixel = 0
    inputBox.Parent = mainFrame
    
    local boxCorner = Instance.new("UICorner")
    boxCorner.CornerRadius = UDim.new(0, 8)
    boxCorner.Parent = inputBox
    
    local statusLabel = Instance.new("TextLabel")
    statusLabel.Name = "StatusLabel"
    statusLabel.Size = UDim2.new(1, -20, 0, 30)
    statusLabel.Position = UDim2.new(0, 10, 0, 165)
    statusLabel.BackgroundTransparency = 1
    statusLabel.Text = "Attempts: " .. KeySystem.Attempts .. "/" .. KeySystem.MaxAttempts
    statusLabel.TextColor3 = Color3.fromRGB(255, 255, 100)
    statusLabel.TextSize = 12
    statusLabel.Font = Enum.Font.Gotham
    statusLabel.Parent = mainFrame
    
    local submitButton = Instance.new("TextButton")
    submitButton.Name = "SubmitButton"
    submitButton.Size = UDim2.new(1, -20, 0, 40)
    submitButton.Position = UDim2.new(0, 10, 0, 205)
    submitButton.BackgroundColor3 = Color3.fromRGB(60, 63, 221)
    submitButton.TextColor3 = Color3.fromRGB(255, 255, 255)
    submitButton.TextSize = 16
    submitButton.Font = Enum.Font.GothamBold
    submitButton.Text = "Submit Key"
    submitButton.BorderSizePixel = 0
    submitButton.Parent = mainFrame
    
    local buttonCorner = Instance.new("UICorner")
    buttonCorner.CornerRadius = UDim.new(0, 8)
    buttonCorner.Parent = submitButton
    
    local function checkKey()
        local enteredKey = inputBox.Text
        
        if enteredKey == KeySystem.ValidKey then
            statusLabel.Text = "✓ Key Accepted!"
            statusLabel.TextColor3 = Color3.fromRGB(0, 255, 0)
            submitButton.Enabled = false
            inputBox.Enabled = false
            
            wait(1)
            screenGui:Destroy()
            loadMainScript()
        else
            KeySystem.Attempts = KeySystem.Attempts + 1
            statusLabel.Text = "Attempts: " .. KeySystem.Attempts .. "/" .. KeySystem.MaxAttempts
            statusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
            inputBox.Text = ""
            
            if KeySystem.Attempts >= KeySystem.MaxAttempts then
                statusLabel.Text = "Max attempts reached!"
                submitButton.Enabled = false
                inputBox.Enabled = false
                
                wait(2)
                player:Kick("Invalid key. Too many attempts.")
            end
        end
    end
    
    submitButton.MouseButton1Click:Connect(checkKey)
    
    inputBox.FocusLost:Connect(function(enterPressed)
        if enterPressed then
            checkKey()
        end
    end)
    
    inputBox:CaptureFocus()
end

